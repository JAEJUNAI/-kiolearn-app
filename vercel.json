{
  "buildCommand": "npx expo export -p web && node scripts/seo-build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/tour", "destination": "/tour.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/i/(.*)", "destination": "/invite.html" },
    { "source": "/connect/jobs", "destination": "/jobs.html" },
    { "source": "/((?!_expo|assets|favicon.ico|api).*)", "destination": "/app-shell.html" }
  ],
  "headers": [
    { "source": "/_expo/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/i/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}

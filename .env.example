# 키오런 앱 환경변수 (로컬). 이 파일은 git에 올라가지 않습니다(.gitignore).
# 값을 채운 뒤  npm run env:push  를 실행하면 Vercel kiolearn-app 프로젝트에 같은 값이 올라갑니다.
# EXPO_PUBLIC_ 로 시작하는 것만 앱(클라이언트)에 포함되고, 나머지는 서버(API 함수)에서만 읽습니다. 서버 값을 EXPO_PUBLIC_ 로 바꾸지 마세요.

# ── Supabase (지금 쓰는 키오런 프로젝트. 대시보드 → Project Settings → API) ──
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 앱 API 주소 (배포 뒤 app.kiolearn.co.kr/api, 로컬 개발은 http://localhost:3000/api) ──
EXPO_PUBLIC_API_BASE=https://app.kiolearn.co.kr/api

# ── 문자 (솔라피. solapi.com 콘솔 → API Key 관리 / 발신번호 관리) ──
SOLAPI_KEY=
SOLAPI_SECRET=
SOLAPI_SENDER=

# ── 인증번호·세션 서명 비밀키 (아무 긴 무작위 문자열. 비워 두면 서버가 서비스 키로 대신 만듭니다) ──
APP_SECRET=

# ── 토스페이먼츠 (결제 붙일 때. 개발자센터 → API 키) ──
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 운영 알림 (선택. 홈페이지 프로젝트와 같은 슬랙 웹훅) ──
SLACK_WEBHOOK_URL=

# ── 1회 셋업(테이블 생성) 보호 토큰. 서버 setup 호출 때만 씀 ──
SETUP_TOKEN=
